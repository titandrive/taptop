<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut android:shortcutId="toggle_taptop" android:enabled="true"
        android:icon="@drawable/ic_shortcut_toggle" android:shortcutShortLabel="@string/shortcut_toggle">
        <intent android:action="android.intent.action.VIEW"
            android:targetPackage="com.taptop.app" android:targetClass="com.taptop.app.ToggleShortcutActivity" />
    </shortcut>
    <shortcut android:shortcutId="scroll_to_top" android:enabled="true"
        android:icon="@drawable/ic_shortcut_scroll" android:shortcutShortLabel="@string/shortcut_scroll">
        <intent android:action="android.intent.action.VIEW"
            android:targetPackage="com.taptop.app" android:targetClass="com.taptop.app.ScrollShortcutActivity" />
    </shortcut>
    <shortcut android:shortcutId="turn_on_taptop" android:enabled="true"
        android:icon="@drawable/ic_start" android:shortcutShortLabel="@string/shortcut_turn_on">
        <intent android:action="android.intent.action.VIEW"
            android:targetPackage="com.taptop.app" android:targetClass="com.taptop.app.TurnOnShortcutActivity" />
    </shortcut>
    <shortcut android:shortcutId="turn_off_taptop" android:enabled="true"
        android:icon="@drawable/ic_stop" android:shortcutShortLabel="@string/shortcut_turn_off">
        <intent android:action="android.intent.action.VIEW"
            android:targetPackage="com.taptop.app" android:targetClass="com.taptop.app.TurnOffShortcutActivity" />
    </shortcut>
</shortcuts>
